<idea-plugin>
    <id>com.aireview.plugin</id>
    <name>智能代码评审助手</name>
    <vendor>AIReview Team</vendor>
    <description><![CDATA[
        基于大模型与规则引擎混合驱动的 IntelliJ IDEA 智能代码评审插件：
        以 PSI 结构感知为基础，规则引擎与大模型双路评审、互相校正，
        为每条评审意见生成证据链，并支持一键修复。
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <actions>
        <action id="com.aireview.ReviewAction"
                class="com.aireview.ui.ReviewAction"
                text="智能代码评审"
                description="对当前文件执行智能代码评审">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="代码评审"
                    anchor="right"
                    factoryClass="com.aireview.ui.ReviewToolWindowFactory"/>
    </extensions>
</idea-plugin>
